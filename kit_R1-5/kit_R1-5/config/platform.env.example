# Copiez ce fichier en config/platform.env sur CHAQUE machine et adaptez-le.
# Identifiant court de la plateforme (utilise dans les noms de fichiers et les tableaux)
#   VM existante : vm   |  x86 physique : x86   |  ARM64 : arm64
PLATFORM_ID=x86

# Cœur utilisé pour le benchmark au niveau opérations (épinglage, comme dans l'article)
OPS_CPU=2
# Cœurs utilisés par ssh + relais + sshd pour les connexions (2 cœurs, comme la VM à 2 vCPU)
CONN_CPUS=2,3

# Répertoire d'installation d'OpenSSH 10.0p2 (créé par 01_build_openssh.sh)
OPENSSH_PREFIX=$HOME/opt/openssh-10.0p2
OPENSSH_SRC=$HOME/src/openssh-portable

# Répertoire de VOTRE harnais existant (matériel supplémentaire de l'article)
HARNESS_DIR=$HOME/harness

# Commandes de VOTRE harnais. Les variables $OUT (répertoire de sortie de la plateforme)
# et $OPENSSH_PREFIX sont disponibles. Reprenez exactement les commandes utilisées pour la VM.
OPS_CMD='./bench_ops --runs 5 --iters 500 --warmup 10 --out "$OUT/ops"'
CONN_LOOPBACK_CMD='python3 run_connections.py --condition loopback --blocks 300 --out "$OUT/e2e"'
CONN_WAN_CMD='python3 run_connections.py --condition wan --blocks 150 --out "$OUT/e2e"'
CONN_CONSTRAINED_CMD='python3 run_connections.py --condition constrained --blocks 100 --out "$OUT/e2e"'
