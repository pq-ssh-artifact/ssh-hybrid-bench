# Copiez ce fichier en config/platform.env et adaptez PLATFORM_ID (le workflow GitHub le fait seul).
#   x86 physique : x86   |  ARM64 : arm64   |  runner GitHub x86 : gh-x86
PLATFORM_ID=x86

# Cœur pour le benchmark d'opérations ; cœurs pour ssh + relais + sshd (2, comme la VM à 2 vCPU)
OPS_CPU=1
CONN_CPUS=0,1

OPENSSH_PREFIX=$HOME/opt/openssh-10.0p2
OPENSSH_SRC=$HOME/src/openssh-portable
HARNESS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/harness

# Protocole de l'article : 5 runs x 500 itérations (10 de chauffe) ; 300/150/100 blocs, graines 1/2/3
OPS_CMD='./bench_ops 5 500 10 "$OUT/ops/ops.csv"'
CONN_LOOPBACK_CMD='python3 run_connections.py --condition loopback --blocks 300 --seed 1 --prefix "$OPENSSH_PREFIX" --out "$OUT/e2e"'
CONN_WAN_CMD='python3 run_connections.py --condition wan --blocks 150 --seed 2 --prefix "$OPENSSH_PREFIX" --out "$OUT/e2e"'
CONN_CONSTRAINED_CMD='python3 run_connections.py --condition constrained --blocks 100 --seed 3 --prefix "$OPENSSH_PREFIX" --out "$OUT/e2e"'
